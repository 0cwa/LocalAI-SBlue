services:
  localai-tls:
    image: @TLS_IMAGE_REF@
    container_name: @TLS_CONTAINER_NAME@
    network_mode: host
    restart: unless-stopped
    userns_mode: keep-id
    security_opt:
      - no-new-privileges
    pids_limit: 512
    volumes:
@TLS_VOLUME_ENTRIES@
    environment:
      HOME: @TLS_APP_HOME_DIR@
      XDG_DATA_HOME: @TLS_DATA_HOME@
      XDG_CONFIG_HOME: @TLS_CONFIG_HOME@
      XDG_CACHE_HOME: @TLS_CACHE_DIR@
    command:
      - caddy
      - run
      - --config
      - @TLS_CADDYFILE_PATH@
