[Unit]
Description=LocalAI OpenAI-compatible API and web UI container
Documentation=https://localai.io/

[Service]
Type=simple
@ADMIN_GATE@
Environment=HOME=@STATE_DIR@
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
Environment=LOCALAI_IMAGE=@IMAGE_REF@
Environment=LOCALAI_CONTAINER_NAME=@CONTAINER_NAME@
Environment=LOCALAI_STATE_DIR=@STATE_DIR@
Environment=LOCALAI_APP_HOME_PATH=@APP_HOME_PATH@
Environment=LOCALAI_ADDRESS=@BIND_HOST@:@BIND_PORT@
Environment=LOCALAI_AUTH=@LOCALAI_AUTH@
Environment=LOCALAI_AUTH_DATABASE_URL=@DATA_PATH@/database.db
Environment=LOCALAI_REGISTRATION_MODE=@LOCALAI_REGISTRATION_MODE@
Environment=LOCALAI_LOG_LEVEL=@LOCALAI_LOG_LEVEL@
Environment=LOCALAI_BACKENDS_PATH=@BACKENDS_PATH@
Environment=LOCALAI_DOWNLOAD_STAGING_PATH=@DOWNLOAD_STAGING_PATH@
Environment=LOCALAI_BACKEND_TEMP_DIR=@BACKEND_TEMP_DIR@
Environment=LOCALAI_MODELS_PATH=@MODELS_PATH@
Environment=LOCALAI_DATA_PATH=@DATA_PATH@
Environment=LOCALAI_CONFIG_DIR=@CONFIG_DIR@
Environment=LOCALAI_GENERATED_CONTENT_PATH=@GENERATED_CONTENT_PATH@
Environment=LOCALAI_UPLOAD_PATH=@UPLOAD_PATH@
Environment=LOCALAI_CACHE_DIR=@CACHE_DIR@
Environment=LOCALAI_LOG_DIR=@LOG_DIR@
Environment=LOCALAI_F16=@LOCALAI_F16@
ExecStart=/usr/bin/podman run --rm --name ${LOCALAI_CONTAINER_NAME} --label=io.localai.secureblue.managed=localai --label=io.localai.secureblue.state=${LOCALAI_STATE_DIR} --label=io.localai.secureblue.container=${LOCALAI_CONTAINER_NAME} --no-healthcheck --userns=keep-id --group-add=keep-groups --security-opt=no-new-privileges --pids-limit=4096 @GPU_DEVICE_ARGS@ --network=host --env HOME=${LOCALAI_APP_HOME_PATH} --env XDG_CACHE_HOME=${LOCALAI_CACHE_DIR} --env TMPDIR=${LOCALAI_BACKEND_TEMP_DIR} --env LOCALAI_ADDRESS=${LOCALAI_ADDRESS} --env LOCALAI_AUTH=${LOCALAI_AUTH} --env LOCALAI_AUTH_DATABASE_URL=${LOCALAI_AUTH_DATABASE_URL} --env LOCALAI_REGISTRATION_MODE=${LOCALAI_REGISTRATION_MODE} --env LOCALAI_LOG_LEVEL=${LOCALAI_LOG_LEVEL} --env LOCALAI_MODELS_PATH=${LOCALAI_MODELS_PATH} --env MODELS_PATH=${LOCALAI_MODELS_PATH} --env LOCALAI_BACKENDS_PATH=${LOCALAI_BACKENDS_PATH} --env LOCALAI_DOWNLOAD_STAGING_PATH=${LOCALAI_DOWNLOAD_STAGING_PATH} --env LOCALAI_BACKEND_TEMP_DIR=${LOCALAI_BACKEND_TEMP_DIR} --env LOCALAI_DATA_PATH=${LOCALAI_DATA_PATH} --env LOCALAI_CONFIG_DIR=${LOCALAI_CONFIG_DIR} --env LOCALAI_GENERATED_CONTENT_PATH=${LOCALAI_GENERATED_CONTENT_PATH} --env LOCALAI_UPLOAD_PATH=${LOCALAI_UPLOAD_PATH} --env LOCALAI_CACHE_DIR=${LOCALAI_CACHE_DIR} --env LOCALAI_LOG_DIR=${LOCALAI_LOG_DIR} --env LOCALAI_F16=${LOCALAI_F16} --volume ${LOCALAI_APP_HOME_PATH}:${LOCALAI_APP_HOME_PATH} --volume ${LOCALAI_MODELS_PATH}:${LOCALAI_MODELS_PATH} --volume ${LOCALAI_DATA_PATH}:${LOCALAI_DATA_PATH} --volume ${LOCALAI_CONFIG_DIR}:${LOCALAI_CONFIG_DIR} --volume ${LOCALAI_GENERATED_CONTENT_PATH}:${LOCALAI_GENERATED_CONTENT_PATH} --volume ${LOCALAI_UPLOAD_PATH}:${LOCALAI_UPLOAD_PATH} --volume ${LOCALAI_CACHE_DIR}:${LOCALAI_CACHE_DIR} --volume ${LOCALAI_LOG_DIR}:${LOCALAI_LOG_DIR} --volume ${LOCALAI_BACKENDS_PATH}:${LOCALAI_BACKENDS_PATH} --volume ${LOCALAI_DOWNLOAD_STAGING_PATH}:${LOCALAI_DOWNLOAD_STAGING_PATH} --volume ${LOCALAI_BACKEND_TEMP_DIR}:${LOCALAI_BACKEND_TEMP_DIR} ${LOCALAI_IMAGE}
ExecStop=/usr/bin/podman stop -t 30 --filter=label=io.localai.secureblue.managed=localai --filter=label=io.localai.secureblue.state=${LOCALAI_STATE_DIR} --filter=label=io.localai.secureblue.container=${LOCALAI_CONTAINER_NAME}
TimeoutStartSec=240
TimeoutStopSec=60
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
