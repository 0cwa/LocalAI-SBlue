#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/.." && pwd)"
if [[ "${1:-}" == --version ]]; then
  [[ "$#" == 1 ]] || { printf 'localaictl: --version accepts no arguments\n' >&2; exit 2; }
  version_file="$script_dir/VERSION"
  [[ -f "$version_file" ]] || version_file="$repo_root/VERSION"
  [[ -f "$version_file" ]] || { printf 'localaictl: VERSION file is missing\n' >&2; exit 1; }
  printf 'localaictl %s\n' "$(<"$version_file")"
  exit 0
fi
# shellcheck source=../lib/config.sh
config_lib="${LOCALAI_CONFIG_LIB:-$repo_root/lib/config.sh}"
[[ -f "$config_lib" ]] || config_lib="$script_dir/config.sh"
# The source path is selected or generated at runtime.
# shellcheck disable=SC1090
source "$config_lib"

run0_bin="${LOCALAI_RUN0_BIN:-/usr/bin/run0}"
systemctl_bin="${LOCALAI_SYSTEMCTL_BIN:-/usr/bin/systemctl}"
system_unit_dir="${LOCALAI_SYSTEM_UNIT_DIR:-/etc/systemd/system}"
journalctl_bin="${LOCALAI_JOURNALCTL_BIN:-/usr/bin/journalctl}"
curl_bin="${LOCALAI_CURL_BIN:-/usr/bin/curl}"
id_bin="${LOCALAI_ID_BIN:-/usr/bin/id}"
date_bin="${LOCALAI_DATE_BIN:-/usr/bin/date}"
sha256_bin="${LOCALAI_SHA256_BIN:-/usr/bin/sha256sum}"
tar_bin="${LOCALAI_TAR_BIN:-/usr/bin/tar}"
matchpathcon_bin="${LOCALAI_MATCHPATHCON_BIN:-/usr/sbin/matchpathcon}"
restorecon_bin="${LOCALAI_RESTORECON_BIN:-/usr/sbin/restorecon}"
cp_bin="${LOCALAI_CP_BIN:-/usr/bin/cp}"
config_file="${LOCALAI_CONFIG_FILE:-/etc/localai/localai.conf}"
legacy_config_file="${LOCALAI_LEGACY_CONFIG_FILE:-$repo_root/localai/localai.lock}"
audit_dir="${LOCALAI_AUDIT_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/localai/audit}"
dry_run=0
status_elevated=0

die() { printf 'localaictl: %s\n' "$*" >&2; exit 1; }
log() { printf '%s\n' "$*"; }
backup_archive_helper_for() {
  local adjacent="$1/backup_archive.py" repository="$2/lib/backup_archive.py"
  if [[ -e "$adjacent" || -L "$adjacent" ]]; then
    [[ -f "$adjacent" && ! -L "$adjacent" ]] || return 1
    printf '%s\n' "$adjacent"
  elif [[ -e "$repository" || -L "$repository" ]]; then
    [[ -f "$repository" && ! -L "$repository" ]] || return 1
    printf '%s\n' "$repository"
  else
    return 1
  fi
}
backup_archive_helper="$(backup_archive_helper_for "$script_dir" "$repo_root")" || die "shared backup archive helper is missing."

if [[ -z "${LOCALAI_CONFIG_FILE:-}" && ! -e "$config_file" ]]; then
  # A repository checkout may use its editable config while developing. An
  # installed tray must use the shared /etc file instead of its old, frozen
  # per-user config snapshot.
  if [[ -f /etc/localai.conf ]]; then
    config_file=/etc/localai.conf
  elif [[ -f "$repo_root/Makefile" && -f "$repo_root/lib/config.sh" && -f "$repo_root/config/localai.conf" ]]; then
    config_file="$repo_root/config/localai.conf"
  fi
fi
localai_config_load_compat "$config_file" "$legacy_config_file"

tls_enabled() {
  # An explicit canonical or environment setting wins over migration
  # detection. Only legacy configurations that never had a TLS key may infer
  # Compose TLS from the current forwarding unit.
  if [[ -n "${LOCALAI_CONFIG_SEEN[LOCALAI_TLS_ENABLED]+x}" ]]; then
    [[ "$LOCALAI_TLS_ENABLED" == true ]]
    return
  fi
  # During migration, the current forwarding unit is the authoritative signal
  # when an older config file has no TLS keys yet. Do not infer TLS from the
  # legacy direct-Caddy unit; that unit must be retired before Compose use.
  # The service user's home is intentionally not traversable by the desktop
  # user, so use the root-readable forwarding unit as the migration marker.
  local socket_unit="$system_unit_dir/$LOCALAI_TLS_FORWARD_SOCKET_NAME"
  [[ -f "$socket_unit" ]] || return 1
  grep -qx 'FreeBind=true' "$socket_unit"
}

service_uid() { "$id_bin" -u "$1"; }

is_effectively_root() { [[ "$EUID" == 0 ]]; }
backup_runtime_dir() {
  if is_effectively_root; then printf '/run\n'; else printf '%s\n' "${XDG_RUNTIME_DIR:-/run}"; fi
}

backup_stage_base() {
  local base="${LOCALAI_RESTORE_STAGE_BASE:-/var/lib/.localaictl-backup-staging}" current
  [[ "$base" == /* && "$base" != /run && "$base" != /run/* && "$base" != /tmp && "$base" != /tmp/* && "$base" != /var/tmp && "$base" != /var/tmp/* ]] || die "restore staging must use an absolute disk-backed directory outside temporary filesystems"
  [[ "$(realpath -m -- "$base")" == "$base" ]] || die "restore staging path must not contain symbolic links or traversal components"
  current="$base"
  while [[ "$current" != / ]]; do
    [[ ! -L "$current" ]] || die "restore staging path must not contain symbolic links"
    current="${current%/*}"
    [[ -n "$current" ]] || current=/
  done
  if [[ ! -e "$base" && ! -L "$base" ]]; then
    [[ -d "${base%/*}" ]] || die "restore staging parent directory must already exist"
    mkdir -m 0700 -- "$base"
  fi
  [[ ! -L "$base" && "$(realpath -e -- "$base")" == "$base" ]] || die "restore staging directory must not use symbolic links"
  [[ -d "$base" && "$(stat -c %a -- "$base")" == 700 ]] || die "restore staging directory must have mode 0700"
  if is_effectively_root; then
    [[ "$(stat -c %u -- "$base")" == 0 ]] || die "restore staging directory must be root-owned"
  else
    [[ "$(stat -c %u -- "$base")" == 0 ]] || die "restore staging must be root-owned"
  fi
  printf '%s\n' "$base"
}

backup_configured_paths=(
  "$LOCALAI_STATE_DIR" "$LOCALAI_MODELS_PATH" "$LOCALAI_BACKENDS_PATH"
  "$LOCALAI_DOWNLOAD_STAGING_PATH" "$LOCALAI_BACKEND_TEMP_DIR" "$LOCALAI_DATA_PATH"
  "$LOCALAI_CONFIG_DIR" "$LOCALAI_GENERATED_CONTENT_PATH" "$LOCALAI_UPLOAD_PATH"
  "$LOCALAI_CACHE_DIR" "$LOCALAI_LOG_DIR" "$LOCALAI_TLS_STATE_DIR"
  "$LOCALAI_TLS_CONFIG_DIR" "$LOCALAI_TLS_CACHE_DIR" "$LOCALAI_TLS_CERT_DIR"
  "$LOCALAI_TLS_COMPOSE_DIR"
)
backup_roots=()

prepare_backup_roots() {
  local path normalized current existing covered
  local -a candidates=()
  backup_roots=()
  for path in "${backup_configured_paths[@]}"; do
    normalized="$(realpath -m -- "$path")"
    [[ "$normalized" == "$path" && "$path" != / ]] || die "configured persistent paths must be normalized absolute paths without symbolic links"
    current="$path"
    while [[ "$current" != / ]]; do
      [[ ! -L "$current" ]] || die "configured persistent paths must not use symbolic links"
      current="${current%/*}"
      [[ -n "$current" ]] || current=/
    done
    candidates+=("$path")
  done
  while IFS= read -r path; do
    covered=0
    for existing in "${backup_roots[@]}"; do
      if [[ "$path" == "$existing" || "$path" == "$existing"/* ]]; then covered=1; break; fi
    done
    [[ "$covered" == 1 ]] || backup_roots+=("$path")
  done < <(printf '%s\0' "${candidates[@]}" | /usr/bin/python3 -c 'import sys; p=sys.stdin.buffer.read().split(b"\0"); p=[x for x in p if x]; [sys.stdout.buffer.write(x+b"\0") for x in sorted(p,key=lambda x:(len(x),x))]' | while IFS= read -r -d '' path; do printf '%s\n' "$path"; done)
  for path in "${backup_roots[@]}"; do
    [[ "$config_file" != "$path" && "$config_file" != "$path"/* && "$path" != "$config_file"/* ]] || die "configuration file must not overlap a persistent data path"
  done
}

# Called through the controller's indirectly selected systemctl helpers.
# shellcheck disable=SC2329
run_elevated() {
  if is_effectively_root; then
    "$@"
  else
    "$run0_bin" -i "$@"
  fi
}

run_elevated_pipe() {
  if is_effectively_root; then
    "$@"
  else
    "$run0_bin" -i --pipe "$@"
  fi
}

# The function is called indirectly by a helper or test.
# shellcheck disable=SC2329
user_manager_systemctl() {
  local service_user="$1"
  shift
  if [[ "${1:-}" == is-active && "$status_elevated" != 1 ]]; then
    # The tray/status path must never show an elevation prompt. Query the
    # named local user manager directly and report unknown if access is denied.
    "$systemctl_bin" --no-ask-password --user --machine="${service_user}@.host" "$@"
  else
    # Elevate as the desktop user to root, then select the service manager
    # explicitly. The service accounts have nologin shells and are never
    # selected as run0's login-shell user.
    run_elevated "$systemctl_bin" --no-ask-password --user --machine="${service_user}@.host" "$@"
  fi
}

# The function is called indirectly by a helper or test.
# shellcheck disable=SC2329
backend_systemctl() { user_manager_systemctl "$LOCALAI_SERVICE_USER" "$@"; }
# The function is called indirectly by a helper or test.
# shellcheck disable=SC2329
tls_systemctl() { user_manager_systemctl "$LOCALAI_TLS_USER" "$@"; }

# The function is called indirectly by a helper or test.
# shellcheck disable=SC2329
root_systemctl() {
  if [[ "${1:-}" == is-active && "$status_elevated" != 1 ]]; then
    "$systemctl_bin" --no-ask-password "$@"
  else
    run_elevated "$systemctl_bin" --no-ask-password "$@"
  fi
}

component_state() {
  local command="$1" unit="$2" output
  if output="$($command is-active "$unit" 2>/dev/null)"; then
    case "$output" in active|inactive|failed|activating|deactivating) printf '%s\n' "$output" ;; *) printf 'unknown\n' ;; esac
  else
    case "$output" in active|inactive|failed|activating|deactivating) printf '%s\n' "$output" ;; *) printf 'unknown\n' ;; esac
  fi
}

backend_state() { component_state backend_systemctl localai.service; }
tls_state() { component_state tls_systemctl "$LOCALAI_TLS_SERVICE_NAME"; }
socket_state() { component_state root_systemctl "$LOCALAI_TLS_FORWARD_SOCKET_NAME"; }

tls_unit_managed() {
  local path="$LOCALAI_TLS_STATE_DIR/.config/systemd/user/$LOCALAI_TLS_SERVICE_NAME" expected_uid owner
  [[ -e "$path" || -L "$path" ]] || return 1
  [[ -f "$path" && ! -L "$path" ]] || die "cannot verify ownership of the configured TLS unit"
  expected_uid="$(service_uid "$LOCALAI_TLS_USER")" || die "cannot verify the TLS service account"
  owner="$(run_elevated /usr/bin/stat -c %u -- "$path")" || die "cannot verify ownership of the configured TLS unit"
  [[ "$owner" == "$expected_uid" ]] || die "configured TLS unit is not owned by the TLS service account"
  run_elevated /usr/bin/grep -qx '# Managed by LocalAI secureblue TLS installer.' "$path" || die "configured TLS unit lacks the LocalAI ownership marker"
}

backend_unit_managed() {
  local path="$LOCALAI_STATE_DIR/.config/systemd/user/localai.service" expected_uid owner mode
  [[ -e "$path" || -L "$path" ]] || return 1
  [[ -f "$path" && ! -L "$path" ]] || die "cannot verify ownership of the configured backend unit"
  expected_uid="$(service_uid "$LOCALAI_SERVICE_USER")" || die "cannot verify the backend service account"
  owner="$(run_elevated /usr/bin/stat -c %u -- "$path")" || die "cannot verify ownership of the configured backend unit"
  [[ "$owner" == "$expected_uid" ]] || die "configured backend unit is not owned by the backend service account"
  run_elevated /usr/bin/grep -qx '# Managed by LocalAI secureblue installer.' "$path" ||
    run_elevated /usr/bin/grep -qx 'Description=LocalAI OpenAI-compatible API and web UI container' "$path" ||
    die "configured backend unit lacks the LocalAI ownership marker"
  mode="$(run_elevated /usr/bin/stat -c %a -- "$path")"
  [[ "$mode" =~ ^[0-7]+$ ]] || die "cannot verify permissions of the configured backend unit"
  (( (8#$mode & 8#22) == 0 )) || die "configured backend unit is group/world writable"
}

verify_restore_backend_unit() {
  local restored_config="$1" unit="$LOCALAI_STATE_DIR/.config/systemd/user/localai.service" dropins environment
  backend_unit_managed || return 1
  run_elevated /usr/bin/python3 /etc/localai/bootstrap-guard.py --unit-restore-safe \
    "$restored_config" "$unit" || return 1
  dropins="$(backend_systemctl show localai.service --property=DropInPaths --value 2>/dev/null)" || return 1
  printf '%s\n' "$dropins" | run_elevated_pipe /usr/bin/python3 /etc/localai/bootstrap-guard.py --dropins-safe || return 1
  environment="$(backend_systemctl show localai.service --property=Environment --value 2>/dev/null)" || return 1
  printf '%s\n' "$environment" | run_elevated_pipe /usr/bin/python3 /etc/localai/bootstrap-guard.py --unit-environment-restore-safe "$restored_config"
}

socket_units_managed() {
  local socket="$system_unit_dir/$LOCALAI_TLS_FORWARD_SOCKET_NAME" service="$system_unit_dir/$LOCALAI_TLS_FORWARD_SERVICE_NAME" path owner
  if [[ ! -e "$socket" && ! -L "$socket" && ! -e "$service" && ! -L "$service" ]]; then return 1; fi
  for path in "$socket" "$service"; do
    [[ -f "$path" && ! -L "$path" ]] || die "cannot verify the configured TLS socket units"
    owner="$(run_elevated /usr/bin/stat -c %u -- "$path")" || die "cannot verify ownership of the configured TLS socket units"
    [[ "$owner" == 0 ]] || die "configured TLS socket unit is not root-owned"
    run_elevated /usr/bin/grep -qx '# Managed by LocalAI secureblue TLS installer.' "$path" || die "configured TLS socket unit lacks the LocalAI ownership marker"
  done
}

config_hash() {
  if [[ -f "$config_file" ]]; then
    "$sha256_bin" "$config_file" | awk '{print $1}'
  else
    printf 'defaults\n'
  fi
}

audit() {
  local action="$1" result="$2" actions="$3" timestamp hash file
  [[ "$dry_run" == 1 ]] && return 0
  mkdir -p "$audit_dir"
  timestamp="$($date_bin -Iseconds)"
  hash="$(config_hash)"
  file="$audit_dir/$($date_bin +%Y-%m-%d).jsonl"
  printf '{"timestamp":"%s","action":"%s","config_hash":"%s","result":"%s","actions":"%s"}\n' \
    "$timestamp" "$action" "$hash" "$result" "$actions" >> "$file"
}

run_or_dry() {
  if [[ "$dry_run" == 1 ]]; then
    printf 'DRY-RUN:'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

start_stack() {
  local result=success actions="backend-start"
  if [[ "$dry_run" != 1 ]] && { [[ "$LOCALAI_AUTH" != true ]] || ! run_elevated /usr/bin/python3 /etc/localai/bootstrap-guard.py "$LOCALAI_DATA_PATH/database.db" >/dev/null 2>&1; }; then
    bootstrap_admin
    return $?
  fi
  if ! run_or_dry backend_systemctl start localai.service; then
    log "start: backend failed; inspect with 'localaictl logs backend'"
    result=failure
  fi
  if tls_enabled; then
    actions+=",tls-start"
    if ! run_or_dry tls_systemctl start "$LOCALAI_TLS_SERVICE_NAME"; then
      log "start: TLS Compose service failed; inspect with 'localaictl logs tls'"
      result=failure
    fi
    if [[ "$LOCALAI_TLS_PUBLIC_SOCKET" == true ]]; then
      actions+=",socket-start"
      if ! run_or_dry root_systemctl start "$LOCALAI_TLS_FORWARD_SOCKET_NAME" "$LOCALAI_TLS_FORWARD_SERVICE_NAME"; then
        log "start: HTTPS socket failed; inspect systemd status and TLS logs"
        result=failure
      fi
    fi
  fi
  audit start "$result" "$actions"
  [[ "$result" == success ]]
}

bootstrap_listener_inactive() {
  local output
  output="$("$@" 2>/dev/null)" || :
  case "$output" in inactive|failed|unknown) return 0 ;; *) return 1 ;; esac
}

bootstrap_listener_disabled() {
  local output
  output="$("$@" 2>/dev/null)" || :
  if [[ -z "$output" && "$#" == 3 ]]; then
    output="$("$1" show "$3" --property=LoadState --value 2>/dev/null)" || :
  elif [[ -z "$output" && "$#" == 4 ]]; then
    output="$("$1" "$2" show "$4" --property=LoadState --value 2>/dev/null)" || :
  fi
  case "$output" in disabled|masked|not-found) return 0 ;; *) return 1 ;; esac
}

bootstrap_ports_clear() {
  command -v ss >/dev/null 2>&1 || return 1
  ss -H -ltn | awk -v public_port="$LOCALAI_TLS_PUBLIC_PORT" -v internal_port="$LOCALAI_TLS_INTERNAL_PORT" '
    $4 ~ (":" public_port "$") || $4 ~ (":" internal_port "$") { found=1 }
    END { exit found ? 1 : 0 }
  '
}

bootstrap_tls_containers_absent() {
  local account="$1" home="$2" uid state containers
  if ! uid="$("$id_bin" -u "$account")"; then
    run_elevated /usr/bin/test ! -e "$home" && run_elevated /usr/bin/test ! -L "$home"
    return $?
  fi
  state="$(root_systemctl is-active "user@$uid.service" 2>/dev/null)" || :
  if [[ "$state" != active ]]; then
    # Do not start a manager that may revive an old container.
    run_elevated /usr/bin/test ! -e "$home/.local/share/containers/storage" &&
      run_elevated /usr/bin/test ! -L "$home/.local/share/containers/storage" &&
      run_elevated /usr/bin/test ! -e "$home/.config/containers/storage.conf" &&
      run_elevated /usr/bin/test ! -L "$home/.config/containers/storage.conf"
    return $?
  fi
  containers="$(run_elevated /usr/bin/systemd-run --user --machine="${account}@.host" --wait --pipe --collect \
    --setenv="HOME=$home" --setenv="XDG_RUNTIME_DIR=/run/user/$uid" \
    --setenv="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus" --setenv=PATH=/usr/bin:/bin \
    -- /usr/bin/podman ps --all --format '{{.ID}}' 2>/dev/null)" || return 1
  [[ -z "$containers" ]]
}

bootstrap_tls_identity_safe() {
  local account="$1" home="$2" unit unit_dir units
  if "$id_bin" -u "$account" >/dev/null 2>&1; then
    tls_footprint=1
    for unit in "$LOCALAI_TLS_SERVICE_NAME" localai-tls-compose.service localai-tls.service; do
      bootstrap_listener_inactive user_manager_systemctl "$account" is-active "$unit" || die "stop the existing TLS service before bootstrap"
      bootstrap_listener_disabled user_manager_systemctl "$account" is-enabled "$unit" || die "disable the existing TLS service before bootstrap"
    done
    unit_dir="$home/.config/systemd/user"
    [[ "$(run_elevated /usr/bin/realpath -m -- "$unit_dir")" == "$unit_dir" ]] || die "cannot inspect a non-canonical TLS user unit directory"
    run_elevated /usr/bin/test ! -L "$unit_dir" || die "cannot inspect a linked TLS user unit directory"
    if run_elevated /usr/bin/test -d "$unit_dir"; then
      [[ -z "$(run_elevated /usr/bin/find -P "$unit_dir" -mindepth 1 -maxdepth 1 -type l -name '*.wants' -print -quit)" ]] || die "cannot inspect a linked TLS wants directory"
      units="$(run_elevated /usr/bin/find -P "$unit_dir" -mindepth 1 -maxdepth 2 -name '*.service' -printf '%f\n')" || die "cannot inspect TLS user units before bootstrap"
      while IFS= read -r unit; do
        [[ -n "$unit" ]] || continue
        [[ "$unit" =~ ^[A-Za-z0-9_.@-]+\.service$ ]] || die "cannot inspect an unexpected TLS user unit name"
        bootstrap_listener_inactive user_manager_systemctl "$account" is-active "$unit" || die "stop TLS user units before bootstrap"
        bootstrap_listener_disabled user_manager_systemctl "$account" is-enabled "$unit" || die "disable TLS user units before bootstrap"
      done <<< "$units"
    elif ! run_elevated /usr/bin/test ! -e "$unit_dir" || ! run_elevated /usr/bin/test ! -L "$unit_dir"; then
      die "cannot inspect the TLS user unit directory"
    fi
  fi
  bootstrap_tls_containers_absent "$account" "$home" || die "inspect TLS-account state and containers before bootstrap"
}

verify_bootstrap_unit() {
  local dropins
  run_elevated /usr/bin/python3 /etc/localai/bootstrap-guard.py --unit-safe \
    "$LOCALAI_DATA_PATH/database.db" "$LOCALAI_BIND_PORT" "$LOCALAI_STATE_DIR/.config/systemd/user/localai.service" || return 1
  dropins="$(backend_systemctl show localai.service --property=DropInPaths --value 2>/dev/null)" || return 1
  printf '%s\n' "$dropins" | /usr/bin/python3 /etc/localai/bootstrap-guard.py --dropins-safe || return 1
  backend_systemctl show localai.service --property=Environment --value 2>/dev/null |
    /usr/bin/python3 /etc/localai/bootstrap-guard.py --unit-environment "$LOCALAI_DATA_PATH/database.db" "$LOCALAI_BIND_PORT"
}

ensure_bootstrap_isolation() {
  local unit_file unit_name tls_footprint=0
  status_elevated=1
  bootstrap_listener_inactive root_systemctl is-active "$LOCALAI_TLS_FORWARD_SOCKET_NAME" || die "stop the existing public TLS socket before bootstrap"
  bootstrap_listener_disabled root_systemctl is-enabled "$LOCALAI_TLS_FORWARD_SOCKET_NAME" || die "disable the existing public TLS socket before bootstrap"
  if [[ "$LOCALAI_TLS_FORWARD_SOCKET_NAME" != localai-tls-forward.socket ]]; then
    bootstrap_listener_inactive root_systemctl is-active localai-tls-forward.socket || die "stop the existing public TLS socket before bootstrap"
    bootstrap_listener_disabled root_systemctl is-enabled localai-tls-forward.socket || die "disable the existing public TLS socket before bootstrap"
  fi
  for unit_file in /etc/systemd/system/*.socket; do
    [[ -f "$unit_file" && ! -L "$unit_file" ]] || continue
    if grep -Fqx '# Managed by LocalAI secureblue TLS installer.' "$unit_file" || grep -Fqx 'Description=LocalAI HTTPS socket' "$unit_file"; then
      tls_footprint=1
      unit_name="${unit_file##*/}"
      bootstrap_listener_inactive root_systemctl is-active "$unit_name" || die "stop the existing managed TLS socket before bootstrap"
      bootstrap_listener_disabled root_systemctl is-enabled "$unit_name" || die "disable the existing managed TLS socket before bootstrap"
    fi
  done
  bootstrap_tls_identity_safe "$LOCALAI_TLS_USER" "$LOCALAI_TLS_STATE_DIR"
  if [[ "$LOCALAI_TLS_USER" != localai-tls || "$LOCALAI_TLS_STATE_DIR" != /var/lib/localai-tls ]]; then
    bootstrap_tls_identity_safe localai-tls /var/lib/localai-tls
  fi
  if [[ "$tls_footprint" == 1 ]]; then
    bootstrap_ports_clear || die "stop listeners on the configured TLS ports before bootstrap"
  fi
}

bootstrap_admin() {
  [[ "$LOCALAI_AUTH" == true && "$LOCALAI_BIND_HOST" == 127.0.0.1 ]] || die "bootstrap requires authentication and a backend bound to 127.0.0.1; update the configuration and reinstall the backend first"
  verify_bootstrap_unit || die "the installed backend unit is not the current authenticated loopback unit; reinstall the backend first"
  ensure_bootstrap_isolation
  run_or_dry backend_systemctl start localai.service || die "could not start the loopback backend"
  log "Open the local backend in your browser and register the intended first administrator."
}

stop_stack() {
  local result=success actions="backend-stop"
  if tls_enabled && [[ "$LOCALAI_TLS_PUBLIC_SOCKET" == true ]]; then
    actions="socket-stop,tls-stop,backend-stop"
    if ! run_or_dry root_systemctl stop "$LOCALAI_TLS_FORWARD_SOCKET_NAME" "$LOCALAI_TLS_FORWARD_SERVICE_NAME"; then
      log "stop: HTTPS socket failed to stop"
      result=failure
    fi
  fi
  if tls_enabled; then
    [[ "$actions" == backend-stop ]] && actions="tls-stop,backend-stop"
    if ! run_or_dry tls_systemctl stop "$LOCALAI_TLS_SERVICE_NAME"; then
      log "stop: TLS Compose service failed to stop"
      result=failure
    fi
  fi
  if ! run_or_dry backend_systemctl stop localai.service; then
    log "stop: backend failed to stop"
    result=failure
  fi
  audit stop "$result" "$actions"
  [[ "$result" == success ]]
}

status_json=0
endpoint_url() {
  local scheme host port default_port
  if tls_enabled; then
    if [[ "$LOCALAI_TLS_PUBLIC_SOCKET" == true ]]; then
      scheme=https
      host="$LOCALAI_TLS_PUBLIC_HOST"
      port="$LOCALAI_TLS_PUBLIC_PORT"
      default_port=443
    else
      scheme=https
      host="$LOCALAI_TLS_INTERNAL_HOST"
      port="$LOCALAI_TLS_INTERNAL_PORT"
      default_port=443
    fi
  else
    scheme=http
    host="$LOCALAI_BIND_HOST"
    port="$LOCALAI_BIND_PORT"
    default_port=80
  fi
  if [[ "$host" == *:* && "$host" != \[*\] ]]; then host="[$host]"; fi
  if [[ "$port" == "$default_port" ]]; then
    printf '%s://%s\n' "$scheme" "$host"
  else
    printf '%s://%s:%s\n' "$scheme" "$host" "$port"
  fi
}

status() {
  local backend tls socket endpoint tls_configured
  backend="$(backend_state)"
  tls="disabled"
  socket="disabled"
  if tls_enabled; then
    tls="$(tls_state)"
    [[ "$LOCALAI_TLS_PUBLIC_SOCKET" == true ]] && socket="$(socket_state)"
  fi
  endpoint="$(endpoint_url)"
  tls_configured=false
  tls_enabled && tls_configured=true
  if [[ "$backend" == unknown || "$tls" == unknown || "$socket" == unknown ]]; then
    if [[ "$status_elevated" == 1 ]]; then
      printf 'localaictl: service-manager status is unavailable; unknown does not mean inactive. Check that the configured user manager is running and reachable.\n' >&2
    else
      printf 'localaictl: service-manager status is unavailable; unknown does not mean inactive. Try status --elevated from a terminal.\n' >&2
    fi
  fi
  if [[ "$status_json" == 1 ]]; then
    printf '{"backend":"%s","tls_compose":"%s","https_socket":"%s","tls_enabled":%s,"endpoint":"%s"}\n' \
      "$backend" "$tls" "$socket" "$tls_configured" "$endpoint"
  else
    printf 'backend: %s\ntls-compose: %s\nhttps-socket: %s\nendpoint: %s\n' "$backend" "$tls" "$socket" "$endpoint"
  fi
  [[ "$backend" == active && ( "$tls_configured" == false || ( "$tls" == active && ( "$socket" == active || "$socket" == disabled ) ) ) ]]
}

logs() {
  local component="${1:-all}"
  case "$component" in
    backend) service_logs "$LOCALAI_SERVICE_USER" localai.service 120 ;;
    tls) service_logs "$LOCALAI_TLS_USER" "$LOCALAI_TLS_SERVICE_NAME" 160 ;;
    all)
      logs backend
      tls_enabled && logs tls
      ;;
    *) die "logs component must be backend, tls, or all" ;;
  esac
}

service_logs() {
  local service_user="$1" user_unit="$2" count="$3" uid
  uid="$(service_uid "$service_user")" || return 1
  # These system accounts write to the system journal. Filter trusted
  # user-unit metadata by both unit and owner UID; --pipe preserves the log
  # stream while run0 elevates through the caller's login shell.
  run_elevated_pipe "$journalctl_bin" --system -n "$count" --no-pager \
    "_SYSTEMD_USER_UNIT=$user_unit" "_SYSTEMD_OWNER_UID=$uid"
}

doctor() {
  local url http_code curl_ok=1 bootstrap_state=unknown
  local _localai_doctor_token="${LOCALAI_DOCTOR_TOKEN:-}"
  local -a curl_args=(--silent --show-error --max-time 5 --output /dev/null --write-out '%{http_code}')
  # Avoid passing the token to service-status subprocesses as well as curl.
  [[ -n "$_localai_doctor_token" ]] && unset LOCALAI_DOCTOR_TOKEN
  status || true
  if [[ "$LOCALAI_AUTH" != true ]]; then
    bootstrap_state=authentication-disabled
  elif [[ -f /etc/localai/bootstrap-guard.py ]]; then
    bootstrap_state="$(/usr/bin/python3 /etc/localai/bootstrap-guard.py --status "$LOCALAI_DATA_PATH/database.db" 2>/dev/null)" || bootstrap_state=unknown
    case "$bootstrap_state" in ready|incomplete|unknown) ;; *) bootstrap_state=unknown ;; esac
  fi
  log "administrator bootstrap: $bootstrap_state"
  url="$(endpoint_url)"
  if [[ "$url" == https://* ]]; then
    if [[ -n "${LOCALAI_DOCTOR_CACERT:-}" ]]; then
      curl_args+=(--cacert "$LOCALAI_DOCTOR_CACERT")
    elif [[ "${LOCALAI_DOCTOR_INSECURE:-false}" == true ]]; then
      curl_args+=(--insecure)
    else
      log "TLS health check uses normal certificate verification; set LOCALAI_DOCTOR_CACERT or LOCALAI_DOCTOR_INSECURE=true for an explicitly chosen local CA policy."
    fi
  fi
  log "health endpoint: $url"
  if [[ -n "$_localai_doctor_token" ]]; then
    # Keep credentials out of curl's argument vector and environment. curl
    # accepts --header @- to read the header line from standard input.
    if ! http_code="$(printf 'Authorization: Bearer %s\n' "$_localai_doctor_token" | "$curl_bin" "${curl_args[@]}" --header @- "$url/v1/models")"; then
      curl_ok=0
    fi
  elif ! http_code="$("$curl_bin" "${curl_args[@]}" "$url/v1/models")"; then
    curl_ok=0
  fi
  if [[ "$curl_ok" == 0 ]]; then
    log "health result: transport or TLS validation failed (no HTTP response)"
    return 1
  fi
  log "health result: HTTP $http_code"
  if [[ "$http_code" =~ ^2[0-9][0-9]$ ]]; then
    return 0
  elif [[ "$http_code" =~ ^4[0-9][0-9]$ ]]; then
    log "health note: the endpoint is reachable, but the request was rejected by authentication or client policy"
  elif [[ "$http_code" =~ ^5[0-9][0-9]$ ]]; then
    log "health note: the endpoint is reachable, but the service reported a server error"
  else
    log "health note: the endpoint returned an unexpected HTTP status"
  fi
  return 1
}

backup_unit_list=()
backup_units() {
  backup_unit_list=(backend)
  if tls_enabled; then
    tls_unit_managed || die "configured TLS service unit is not verifiably managed by LocalAI"
    backup_unit_list+=(tls)
    if [[ "$LOCALAI_TLS_PUBLIC_SOCKET" == true ]]; then
      socket_units_managed || die "configured TLS socket units are not verifiably managed by LocalAI"
      backup_unit_list+=(socket)
    elif socket_units_managed; then
      # A previously installed managed socket may remain active after config
      # disables it; inventory it so backup/restore preserves its real state.
      backup_unit_list+=(socket)
    fi
  else
    tls_unit_managed && backup_unit_list+=(tls)
    socket_units_managed && backup_unit_list+=(socket)
  fi
  return 0
}

backup_unit_state() {
  case "$1" in
    backend) backend_state ;;
    tls) tls_state ;;
    socket) socket_state ;;
    *) return 2 ;;
  esac
}

backup_unit_action() {
  local unit="$1" action="$2"
  case "$unit" in
    backend) backend_systemctl "$action" localai.service ;;
    tls) tls_systemctl "$action" "$LOCALAI_TLS_SERVICE_NAME" ;;
    socket) root_systemctl "$action" "$LOCALAI_TLS_FORWARD_SOCKET_NAME" "$LOCALAI_TLS_FORWARD_SERVICE_NAME" ;;
    *) return 2 ;;
  esac
}

restore_backup_service_state() {
  local unit status=0
  for unit in backend tls socket; do
    if [[ " ${backup_was_active[*]:-} " == *" $unit "* ]]; then
      backup_unit_action "$unit" start || { printf 'localaictl: warning: could not restore the previous %s service state\n' "$unit" >&2; status=1; }
    fi
  done
  return "$status"
}

backup_stop_services() {
  local unit state
  backup_units
  backup_was_active=()
  for unit in "${backup_unit_list[@]}"; do
    state="$(backup_unit_state "$unit")"
    case "$state" in
      active) backup_was_active+=("$unit") ;;
      inactive|failed) ;;
      *) die "cannot determine a stable $unit service state; refusing backup or restore" ;;
    esac
  done
  for unit in socket tls backend; do
    if [[ " ${backup_was_active[*]:-} " == *" $unit "* ]]; then
      backup_unit_action "$unit" stop || die "could not stop $unit service for backup"
      state="$(backup_unit_state "$unit")"
      [[ "$state" == inactive || "$state" == failed ]] || die "could not verify that $unit service stopped"
    fi
  done
}

backup() {
  local exclude_models=0 destination path lock_file destination_parent tmp status
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --exclude-models) [[ "$exclude_models" == 0 ]] || die "backup accepts --exclude-models once"; exclude_models=1; shift ;;
      --*) die "unknown backup option: $1" ;;
      *) break ;;
    esac
  done
  [[ "$#" == 1 ]] || die "backup requires one destination path"
  destination="$1"
  [[ "$destination" == /* ]] || destination="$PWD/$destination"
  [[ ! -e "$destination" && ! -L "$destination" ]] || die "backup destination already exists"
  [[ -d "${destination%/*}" ]] || die "backup destination directory does not exist"
  destination_parent="${destination%/*}"
  [[ "$(realpath -m -- "$destination_parent")" == "$destination_parent" ]] || die "backup destination parent must not contain symbolic links or traversal components"
  destination="$(realpath -m -- "$destination")"
  prepare_backup_roots
  for path in "$config_file" "${backup_roots[@]}"; do
    [[ "$destination" != "$path" && "$destination" != "$path"/* ]] || die "backup destination must be outside the configuration and persistent data paths"
  done
  lock_file=/run/lock/localai-backup.lock
  tmp="$(mktemp "${destination%/*}/.localaictl-backup.XXXXXX")"
  chmod 0600 "$tmp"
  local -a args=(--archive-file "$tmp")
  [[ "$exclude_models" == 0 ]] || args=(--exclude-models "${args[@]}")
  if run_elevated_pipe /usr/bin/flock -n -E 75 "$lock_file" "$script_dir/localaictl" __backup "${args[@]}" >"$tmp"; then
    :
  else
    status=$?
    rm -f -- "$tmp"
    [[ "$status" != 75 ]] || die "backup or restore is already running"
    return "$status"
  fi
  if ! ln -- "$tmp" "$destination"; then
    rm -f -- "$tmp"
    die "could not create backup without overwriting another file"
  fi
  rm -f -- "$tmp"
  log "Backup created: $destination"
}

backup_locked() {
  local exclude_models=0 archive_file metadata_dir runtime_dir archive_args=() path
  if [[ "${1:-}" == --exclude-models ]]; then exclude_models=1; shift; fi
  [[ "${1:-}" == --archive-file && "$#" == 2 ]] || die "internal backup requires an archive stream target"
  archive_file="$2"
  runtime_dir="$(backup_runtime_dir)"
  prepare_backup_roots
  if [[ -e "$config_file" ]] && is_effectively_root; then
    [[ -f "$config_file" && ! -L "$config_file" && "$(stat -c %u -- "$config_file")" == 0 ]] || die "configuration file must be a root-owned regular file to back up"
    (( (8#$(stat -c %a -- "$config_file") & 8#22) == 0 )) || die "configuration file must not be group/world writable to back up"
  fi
  printf 'WARNING: this backup contains the TLS CA private key and LocalAI authentication database. Store it securely.\n' >&2
  backup_was_active=()
  backup_tmp=""
  backup_metadata_dir=""
  trap 'backup_exit_cleanup' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  backup_stop_services
  metadata_dir="$(mktemp -d "$runtime_dir/localai-backup.XXXXXX")"
  backup_metadata_dir="$metadata_dir"
  chmod 0700 "$metadata_dir"
  printf 'format=1\nbackend_image=%s\nbackend_digest=%s\ntls_image=%s\ntls_digest=%s\n' \
    "$LOCALAI_IMAGE_REF" "$LOCALAI_IMAGE_DIGEST" "$LOCALAI_TLS_IMAGE_REF" "$LOCALAI_TLS_IMAGE_DIGEST" >"$metadata_dir/metadata"
  chmod 0600 "$metadata_dir/metadata"
  archive_args=(--create --gzip --file - --xattrs --acls --selinux --numeric-owner)
  if [[ "$exclude_models" == 1 ]]; then
    path="${LOCALAI_MODELS_PATH#/}"
    archive_args+=(--exclude="$path" --exclude="$path/*")
  fi
  archive_args+=(--directory "$metadata_dir" metadata --directory /)
  [[ -e "$config_file" ]] && archive_args+=("${config_file#/}")
  for path in "${backup_roots[@]}"; do [[ -e "$path" ]] && archive_args+=("${path#/}"); done
  run_elevated_pipe "$tar_bin" "${archive_args[@]}" || die "backup archive creation failed"
  run_elevated /usr/bin/python3 "$backup_archive_helper" validate-created "$archive_file" "$config_file" "${backup_roots[@]}" || die "backup contains unsupported or unsafe filesystem entries"
  rm -rf -- "$metadata_dir"
  backup_metadata_dir=""
  restore_backup_service_state || die "backup completed but one or more previously active services could not be restarted"
  trap - EXIT HUP INT TERM
}

# Called indirectly by the backup EXIT trap.
# shellcheck disable=SC2329
backup_exit_cleanup() {
  [[ -z "${backup_tmp:-}" ]] || rm -f -- "$backup_tmp"
  [[ -z "${backup_metadata_dir:-}" ]] || rm -rf -- "$backup_metadata_dir"
  restore_backup_service_state || :
}

restore_archive() {
  local source="$1" lock_file status
  [[ -f "$source" && ! -L "$source" ]] || die "restore source must be a regular, non-linked archive file"
  source="$(realpath -e -- "$source")"
  lock_file=/run/lock/localai-backup.lock
  local -a args=("$source")
  [[ "${restore_confirmed:-0}" == 0 ]] || args=(--yes "$source")
  if run_elevated_pipe /usr/bin/flock -n -E 75 "$lock_file" "$script_dir/localaictl" __restore "${args[@]}"; then
    :
  else
    status=$?
    [[ "$status" != 75 ]] || die "backup or restore is already running"
    return "$status"
  fi
}

restore_locked() {
  local source="$1" stage source_copy members collisions snapshot skip_links target answer item had_target=0 stage_base needs_confirmation=0
  local restore_mutation_started=0 restore_completed=0
  local helper="$backup_archive_helper"
  [[ -f "$source" && ! -L "$source" ]] || die "restore source must be a regular, non-linked archive file"
  prepare_backup_roots
  source="$(realpath -e -- "$source")"
  stage_base="$(backup_stage_base)"
  stage="$(mktemp -d "$stage_base/localai-restore.XXXXXX")"
  backup_was_active=()
  RESTORE_ROLLBACK_FAILED=0
  RESTORE_SERVICES_STOPPED=0
  trap 'restore_exit_cleanup' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  chmod 0700 "$stage"
  members="$stage/members0"
  collisions="$stage/collisions0"
  snapshot="$stage/rollback.tar"
  skip_links="$stage/skip-links0"
  source_copy="$stage/input.tar.gz"
  run_elevated /usr/bin/python3 "$helper" stage-check "$stage" || die "restore staging must be on a disk-backed filesystem"
  run_elevated /usr/bin/python3 "$helper" space-check "$source" "$stage" || die "insufficient disk space for a safe restore stage"
  run_elevated /usr/bin/python3 "$helper" copy-source "$source" "$config_file" "${backup_roots[@]}" "$source_copy" || die "could not safely copy restore archive"
  source="$source_copy"
  run_elevated /usr/bin/python3 "$helper" validate "$source" "$config_file" "${backup_roots[@]}" || die "backup contains unsupported or unsafe filesystem entries"
  run_elevated "$tar_bin" --extract --gzip --file "$source" --directory "$stage" --xattrs --acls --selinux --numeric-owner --same-owner || die "could not extract backup into private staging"
  run_elevated /usr/bin/python3 "$helper" destinations "$source" "$config_file" "${backup_roots[@]}" "$stage" || die "restore paths are unsafe"
  run_elevated /usr/bin/python3 "$helper" skip-links0 "$source" "$config_file" "${backup_roots[@]}" "$stage" >"$skip_links"
  run_elevated /usr/bin/python3 "$helper" members0 "$source" "$config_file" "${backup_roots[@]}" >"$members"
  run_elevated /usr/bin/python3 "$helper" collisions0 "$source" "$config_file" "${backup_roots[@]}" >"$collisions"
  run_elevated /usr/bin/python3 "$helper" unit-trees0 "$source" "$config_file" "${backup_roots[@]}" "$stage" "$LOCALAI_STATE_DIR" "$LOCALAI_TLS_STATE_DIR" >"$stage/unit-trees0" || die "backup contains unsafe or changed systemd unit configuration"
  if grep -zFxq "${LOCALAI_STATE_DIR#/}/.config/systemd/user/localai.service" "$members"; then
    verify_restore_backend_unit "$stage/${config_file#/}" || die "restored config does not match the trusted installed backend unit and manager settings"
  fi
  for target in "${backup_roots[@]}"; do
    if [[ -d "$target" ]] && [[ -n "$(run_elevated find "$target" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then needs_confirmation=1; fi
  done
  [[ ! -e "$config_file" ]] || needs_confirmation=1
  if [[ "$needs_confirmation" == 1 && "${restore_confirmed:-0}" != 1 ]]; then
    [[ -t 0 ]] || die "restore requires --yes in non-interactive use"
    printf 'This overlays LocalAI configuration and state, including the TLS CA key and authentication database. Continue? [y/N] ' >&2
    read -r answer
    [[ "$answer" == y || "$answer" == Y ]] || die "restore cancelled"
    restore_confirmed=1
  fi
  RESTORE_SERVICES_STOPPED=1
  backup_stop_services
  run_elevated /usr/bin/python3 "$helper" destinations "$source" "$config_file" "${backup_roots[@]}" "$stage" || die "restore paths changed while services stopped"
  run_elevated /usr/bin/python3 "$helper" skip-links0 "$source" "$config_file" "${backup_roots[@]}" "$stage" >"$skip_links"
  run_elevated /usr/bin/python3 "$helper" collisions0 "$source" "$config_file" "${backup_roots[@]}" >"$collisions"
  needs_confirmation=0
  for target in "${backup_roots[@]}"; do
    if [[ -d "$target" ]] && [[ -n "$(run_elevated find "$target" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then needs_confirmation=1; fi
  done
  [[ ! -e "$config_file" ]] || needs_confirmation=1
  if [[ "$needs_confirmation" == 1 && "${restore_confirmed:-0}" != 1 ]]; then
    die "restore targets changed before restore; rerun with --yes after reviewing the overwrite"
  fi
  [[ ! -s "$collisions" ]] || had_target=1
  run_elevated /usr/bin/python3 "$helper" space-check "$source" "$stage" --staged "$collisions" --destinations "$config_file" "${backup_roots[@]}" || die "insufficient disk space for the restore and rollback snapshot"
  if [[ "$had_target" == 1 ]]; then
    run_elevated "$tar_bin" --create --file "$snapshot" --xattrs --acls --selinux --numeric-owner --no-recursion --directory / --null --files-from="$collisions" || die "could not prepare rollback snapshot"
  fi
  local -a links_to_keep=()
  mapfile -d '' -t links_to_keep <"$skip_links"
  for item in "${links_to_keep[@]}"; do run_elevated /usr/bin/rm -f -- "$stage/$item"; done
  mapfile -d '' -t links_to_keep <"$stage/unit-trees0"
  for item in "${links_to_keep[@]}"; do
    run_elevated /usr/bin/rm -rf -- "${stage:?}/$item"
  done
  restore_mutation_started=1
  for target in "${backup_roots[@]}"; do
    if [[ -d "$stage/${target#/}" ]]; then mkdir -p -- "$target"; fi
  done
  if [[ -e "$stage/${config_file#/}" ]]; then mkdir -p -- "${config_file%/*}"; fi
  for target in "${backup_roots[@]}"; do
    if [[ -d "$stage/${target#/}" && ! -L "$stage/${target#/}" ]]; then
      run_elevated "$cp_bin" -a -- "$stage/${target#/}/." "$target/" || die "restore failed; rollback will run before services restart"
      run_elevated "$cp_bin" -a --attributes-only -- "$stage/${target#/}" "$target" || die "restore failed while applying persistent root metadata; rollback will run before services restart"
    fi
  done
  if [[ -e "$stage/${config_file#/}" ]]; then
    run_elevated "$cp_bin" -a -- "$stage/${config_file#/}" "$config_file" || die "restore failed; rollback will run before services restart"
  fi
  if [[ -e "$stage/${config_file#/}" ]]; then
    run_elevated "$restorecon_bin" -F -- "$config_file" || die "could not normalize restored configuration SELinux label; rollback will run before services restart"
    run_elevated "$matchpathcon_bin" -V "$config_file" || die "configuration SELinux label verification failed; rollback will run before services restart"
  fi
  for target in "${backup_roots[@]}"; do
    [[ -e "$target" ]] || continue
    run_elevated "$matchpathcon_bin" -V "$target" || die "SELinux label verification failed; rollback will run before services restart"
  done
  restore_completed=1
  run_elevated /usr/bin/rm -rf -- "$stage"
  restore_backup_service_state || die "restore completed but one or more previously active services could not be restarted"
  trap - EXIT HUP INT TERM
  log "Backup restored. State was overlaid, unrelated files were preserved, and configured root labels were verified."
}

# Called indirectly by the restore EXIT trap.
# shellcheck disable=SC2329
restore_rollback() {
  local members="$1" collisions="$2" snapshot="$3" had_target="$4"
  local status=0
  run_elevated /usr/bin/python3 "$backup_archive_helper" rollback-new "$source" "$config_file" "${backup_roots[@]}" "$members" "$collisions" || { log "warning: could not remove all newly restored paths"; status=1; }
  if [[ "$had_target" == 1 ]]; then
    run_elevated "$tar_bin" --extract --file "$snapshot" --directory / --xattrs --acls --selinux --numeric-owner --same-owner || { log "warning: could not restore the rollback snapshot"; status=1; }
  fi
  return "$status"
}

# Called indirectly by the restore EXIT trap.
# shellcheck disable=SC2329
restore_exit_cleanup() {
  local exit_status=$?
  trap - EXIT HUP INT TERM
  trap '' HUP INT TERM
  if [[ "${restore_mutation_started:-0}" == 1 && "${restore_completed:-0}" != 1 ]]; then
    restore_rollback "$members" "$collisions" "$snapshot" "$had_target" || RESTORE_ROLLBACK_FAILED=1
  fi
  [[ -z "${stage:-}" ]] || run_elevated /usr/bin/rm -rf -- "$stage"
  if [[ "${RESTORE_ROLLBACK_FAILED:-0}" == 1 ]]; then
    printf 'localaictl: warning: rollback was incomplete; previously active services remain stopped for manual recovery\n' >&2
    [[ "$exit_status" != 0 ]] || exit 1
    exit "$exit_status"
  fi
  if [[ "${RESTORE_SERVICES_STOPPED:-0}" == 1 ]]; then
    restore_backup_service_state || exit 1
  fi
  exit "$exit_status"
}

usage() {
  cat <<'EOF'
Usage: localaictl --version | [--dry-run] <bootstrap-admin|start|stop|restart|status [--json] [--elevated]|logs [backend|tls|all]|doctor|backup [--exclude-models] <dest>|restore [--yes] <src>>

The command controls only the known LocalAI backend, TLS Compose service, and
TLS forward socket. It does not accept arbitrary systemd or Podman commands.

Backup stops active services temporarily and starts them again afterwards.
Use `backup --exclude-models` to omit the configured models directory. Restore
requires an empty target or `--yes` to confirm replacing configuration/state.

doctor uses normal TLS verification. For the local Caddy CA, set
LOCALAI_DOCTOR_CACERT=/path/to/root.crt. Use LOCALAI_DOCTOR_TOKEN only for a
token supplied through a protected environment, and use
LOCALAI_DOCTOR_INSECURE=true only as an explicit temporary diagnostic choice.

Status reads do not prompt. Use status --elevated from a terminal when a
service manager does not allow the current user to read its state.
EOF
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --dry-run) dry_run=1; shift ;;
    __verify-bootstrap-isolation)
      shift
      [[ "$#" == 0 && "$EUID" == 0 ]] || die "internal isolation check requires root"
      ensure_bootstrap_isolation
      exit $?
      ;;
    __verify-bootstrap-isolation-if-needed)
      shift
      [[ "$#" == 0 && "$EUID" == 0 ]] || die "internal isolation check requires root"
      if [[ "$LOCALAI_AUTH" != true ]] || ! /usr/bin/python3 "$repo_root/lib/bootstrap_guard.py" "$LOCALAI_DATA_PATH/database.db"; then
        ensure_bootstrap_isolation
      fi
      exit $?
      ;;
    __backup)
      shift
      backup_locked "$@"
      exit $?
      ;;
    __restore)
      shift
      restore_confirmed=0
      if [[ "${1:-}" == --yes ]]; then restore_confirmed=1; shift; fi
      [[ "$#" == 1 ]] || die "internal restore requires one source archive"
      restore_locked "$1"
      exit $?
      ;;
    bootstrap-admin)
      shift
      [[ "$#" == 0 ]] || die "bootstrap-admin accepts no arguments"
      bootstrap_admin
      exit $?
      ;;
    start)
      shift
      [[ "$#" == 0 ]] || die "start accepts no arguments"
      start_stack
      exit $?
      ;;
    backup)
      shift
      backup "$@"
      exit $?
      ;;
    restore)
      shift
      restore_confirmed=0
      if [[ "${1:-}" == --yes ]]; then restore_confirmed=1; shift; fi
      [[ "$#" == 1 ]] || die "restore accepts [--yes] and one source archive"
      restore_archive "$1"
      exit $?
      ;;
    stop)
      shift
      [[ "$#" == 0 ]] || die "stop accepts no arguments"
      stop_stack
      exit $?
      ;;
    restart)
      shift
      [[ "$#" == 0 ]] || die "restart accepts no arguments"
      stop_stack && start_stack
      exit $?
      ;;
    status)
      shift
      while [[ "$#" -gt 0 ]]; do
        case "$1" in
          --json) status_json=1 ;;
          --elevated) status_elevated=1 ;;
          *) die "status accepts only --json and --elevated" ;;
        esac
        shift
      done
      status
      exit $?
      ;;
    logs)
      shift
      [[ "$#" -le 1 ]] || die "logs accepts at most one component"
      logs "${1:-all}"
      exit $?
      ;;
    doctor)
      shift
      [[ "$#" == 0 ]] || die "doctor accepts no arguments"
      doctor
      exit $?
      ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; die "unknown command '$1'" ;;
  esac
done
usage >&2
exit 2
